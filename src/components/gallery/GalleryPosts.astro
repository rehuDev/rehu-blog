---
import type { CollectionEntry } from 'astro:content';
import missingPostImage from '../../assets/imgs/missing-image.avif';
import { GALLERY_PAGE_GROUP_SIZE } from '../../lib/gallery';

interface Props {
  gallery: CollectionEntry<'gallery'>;
  posts: CollectionEntry<'post'>[];
  currentPage: number;
  totalPages: number;
  currentPostId?: string;
}

const {
  gallery,
  posts,
  currentPage,
  totalPages,
  currentPostId,
} = Astro.props;

const pageGroupStart = Math.floor((currentPage - 1) / GALLERY_PAGE_GROUP_SIZE)
  * GALLERY_PAGE_GROUP_SIZE + 1;
const pageGroupEnd = Math.min(pageGroupStart + GALLERY_PAGE_GROUP_SIZE - 1, totalPages);
const pageNumbers = Array.from(
  { length: pageGroupEnd - pageGroupStart + 1 },
  (_, index) => pageGroupStart + index,
);

const getGalleryPageHref = (page: number) => (
  page === 1 ? `/g/${gallery.id}/` : `/g/${gallery.id}/${page}/`
);

const postDateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Tokyo',
});

const formatPostDate = (date: Date) => postDateFormatter.format(date).replaceAll('/', '.');

const getPostImageSrc = (image?: string) => {
  const src = image?.trim();

  if (!src || /^[a-z][a-z\d+.-]*:/i.test(src) || src.startsWith('//') || src.startsWith('/')) {
    return src;
  }

  return `/${src.replace(/^\.\//, '')}`;
};
---

<section class="gallery-posts" aria-label="投稿一覧">
  <div class="gallery-post-toolbar">
    <div class="gallery-post-toolbar-group" role="group" aria-label="投稿の種類">
      <button class="gallery-post-toolbar-button" type="button" aria-pressed="true">全体</button>
      <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">人気</button>
      <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">お知らせ</button>
    </div>
    <div class="gallery-post-toolbar-group" role="group" aria-label="表示形式">
      <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">簡潔</button>
      <button class="gallery-post-toolbar-button" type="button" aria-pressed="true">画像</button>
    </div>
  </div>
  <div class="gallery-post-table-head" aria-hidden="true">
    <span>投稿</span>
    <span>公開日</span>
  </div>
  <div class="gallery-post-list">
    {posts.map((post) => {
      const postHref = `/posts/${post.id}/?g=${encodeURIComponent(gallery.id)}`;
      const postImage = getPostImageSrc(post.data.image);
      const isCurrentPost = post.id === currentPostId;

      return (
        <article class:list={['gallery-post-item', { 'is-current': isCurrentPost }]}> 
          <a class="gallery-post-link" href={postHref} aria-current={isCurrentPost ? 'page' : undefined}>
            <span class="gallery-post-thumbnail" aria-hidden="true">
              {postImage
                ? <img src={postImage} alt="" loading="lazy" decoding="async" />
                : <img src={missingPostImage.src} alt="" loading="lazy" decoding="async" />}
            </span>
            <div class="gallery-post-content">
              <div class="gallery-post-body">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <div class="gallery-post-details">
                <div class="gallery-post-tags">
                  {post.data.mcategories?.map((category) => <span data-post-tag>{category}</span>)}
                  <span
                    class="gallery-post-tags-more"
                    aria-label="その他のタグ"
                    data-post-tags-more
                    hidden
                  >…</span>
                </div>
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              </div>
            </div>
          </a>
        </article>
      );
    })}
    {posts.length === 0 && <p class="gallery-post-empty">まだ投稿はありません。</p>}
  </div>

  {totalPages > 1 && (
    <nav class="gallery-pagination" aria-label="投稿ページ">
      {currentPage > 1
        ? <a class="pagination-link pagination-direction" href={getGalleryPageHref(currentPage - 1)}>前へ</a>
        : <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">前へ</span>}

      <div class="pagination-numbers">
        {pageNumbers.map((page) => (
          page === currentPage
            ? <span class="pagination-link is-current" aria-current="page">{page}</span>
            : <a class="pagination-link" href={getGalleryPageHref(page)}>{page}</a>
        ))}
      </div>

      {currentPage < totalPages
        ? <a class="pagination-link pagination-direction" href={getGalleryPageHref(currentPage + 1)}>次へ</a>
        : <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">次へ</span>}
    </nav>
  )}
</section>

<script>
  const fitPostTags = () => {
    document.querySelectorAll<HTMLElement>('.gallery-post-tags').forEach((tagList) => {
      const tags = [...tagList.querySelectorAll<HTMLElement>('[data-post-tag]')];
      const moreTag = tagList.querySelector<HTMLElement>('[data-post-tags-more]');

      tags.forEach((tag) => tag.hidden = false);
      if (moreTag) moreTag.hidden = true;

      const listRight = tagList.getBoundingClientRect().right;
      let hasOverflow = false;

      for (const tag of tags) {
        if (hasOverflow || tag.getBoundingClientRect().right > listRight + 0.5) {
          tag.hidden = true;
          hasOverflow = true;
        }
      }

      if (!hasOverflow || !moreTag) return;

      moreTag.hidden = false;

      while (moreTag.getBoundingClientRect().right > listRight + 0.5) {
        const lastVisibleTag = tags.findLast((tag) => !tag.hidden);
        if (!lastVisibleTag) break;
        lastVisibleTag.hidden = true;
      }
    });
  };

  const postTagLists = document.querySelectorAll<HTMLElement>('.gallery-post-tags');

  if (postTagLists.length > 0) {
    const postTagResizeObserver = new ResizeObserver(fitPostTags);
    postTagLists.forEach((tagList) => postTagResizeObserver.observe(tagList));
    requestAnimationFrame(fitPostTags);
  }
</script>

<style>
  .gallery-posts {
    margin-top: 10px;
  }

  .gallery-post-toolbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 6px;
  }

  .gallery-post-toolbar-group {
    display: flex;
    align-items: center;
    gap: 3px;
    min-width: 0;
  }

  .gallery-post-toolbar-button {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    height: 27px;
    padding: 0 8px;
    border: 1px solid #cfd4df;
    background: #f8f9fc;
    color: #475467;
    font: inherit;
    font-size: 11px;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }

  .gallery-post-toolbar-button:hover,
  .gallery-post-toolbar-button:focus-visible {
    border-color: var(--dc-blue-2);
    color: var(--dc-blue-2);
    outline: none;
  }

  .gallery-post-toolbar-button[aria-pressed="true"] {
    border-color: var(--dc-blue-2);
    background: var(--dc-blue-2);
    color: #fff;
    font-weight: 700;
  }

  .gallery-post-list {
    display: grid;
  }

  .gallery-post-table-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 7px 0;
    border-top: 2px solid var(--dc-blue-2);
    border-bottom: 1px solid #d5dbea;
    background: #f7f8fb;
    color: #667085;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
  }

  .gallery-post-table-head span:last-child {
    text-align: right;
  }

  .gallery-post-item {
    border-bottom: 1px solid #e1e4ea;
  }

  .gallery-post-item.is-current {
    background: #f4f6ff;
    box-shadow: inset 3px 0 0 var(--dc-blue-2);
  }

  .gallery-post-link {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 6px 0;
    color: inherit;
    text-decoration: none;
  }

  .gallery-post-link:hover,
  .gallery-post-link:focus-visible {
    background: #fafbff;
    outline: none;
  }

  .gallery-post-link:focus-visible {
    box-shadow: inset 0 0 0 2px var(--dc-blue-2);
  }

  .gallery-post-thumbnail {
    display: grid;
    position: relative;
    place-items: center;
    width: 96px;
    height: 72px;
    overflow: hidden;
    background: #e9edff;
    text-decoration: none;
  }

  .gallery-post-thumbnail :global(img) {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .gallery-post-content,
  .gallery-post-body {
    min-width: 0;
  }

  .gallery-post-details {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px 10px;
    margin-top: 7px;
    color: #667085;
    font-size: 11px;
  }

  .gallery-post-tags {
    display: flex;
    flex: 1 1 auto;
    flex-wrap: nowrap;
    gap: 4px;
    min-width: 0;
    overflow: hidden;
  }

  .gallery-post-tags span {
    flex: 0 0 auto;
    padding: 1px 5px;
    background: #f1f4ff;
    color: var(--dc-blue-2);
  }

  .gallery-post-tags span[hidden] {
    display: none;
  }

  .gallery-post-tags-more {
    min-width: 18px;
    font-weight: 700;
    text-align: center;
  }

  .gallery-post-details time {
    flex: 0 0 auto;
    color: #7a8494;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .gallery-post-body h2 {
    margin: 0;
    overflow: hidden;
    color: #1f2937;
    font-size: 15px;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gallery-post-body p {
    display: -webkit-box;
    margin: 4px 0 0;
    overflow: hidden;
    color: #667085;
    font-size: 12px;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    line-clamp: 1;
  }

  .gallery-post-empty {
    margin: 0;
    padding: 32px 16px;
    border-bottom: 1px solid #e1e4ea;
    color: #98a2b3;
    font-size: 13px;
    text-align: center;
  }

  .gallery-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    margin-top: 18px;
  }

  .pagination-numbers {
    display: flex;
    gap: 4px;
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .pagination-numbers::-webkit-scrollbar {
    display: none;
  }

  .pagination-link {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    min-width: 30px;
    height: 30px;
    padding: 0 8px;
    border: 1px solid #d5dbea;
    background: #fff;
    color: #475467;
    font-size: 12px;
    line-height: 1;
    text-decoration: none;
  }

  a.pagination-link:hover,
  a.pagination-link:focus-visible {
    border-color: var(--dc-blue-2);
    color: var(--dc-blue-2);
    outline: none;
  }

  .pagination-direction {
    min-width: 46px;
  }

  .pagination-link.is-current {
    border-color: var(--dc-blue-2);
    background: var(--dc-blue-2);
    color: #fff;
    font-weight: 700;
  }

  .pagination-link.is-disabled {
    background: #f5f6f8;
    color: #a4aab5;
  }

  @media (min-width: 640px) {
    .gallery-post-link {
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 16px;
      padding: 8px 0;
    }

    .gallery-post-thumbnail {
      width: 160px;
      height: 100px;
    }

    .gallery-post-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 84px;
      column-gap: 16px;
      align-content: start;
    }

    .gallery-post-body {
      grid-column: 1;
      grid-row: 1;
    }

    .gallery-post-details {
      display: contents;
    }

    .gallery-post-tags {
      grid-column: 1;
      grid-row: 2;
      margin-top: 8px;
    }

    .gallery-post-details time {
      grid-column: 2;
      grid-row: 1;
      align-self: start;
      justify-self: end;
      margin-top: 3px;
    }

    .gallery-post-body h2 {
      font-size: 17px;
    }

    .gallery-post-body p {
      font-size: 13px;
      -webkit-line-clamp: 2;
      line-clamp: 2;
    }
  }
</style>
