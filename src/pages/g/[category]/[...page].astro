---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import GalleryHeader from '../../../components/gallery/GalleryHeader.astro';
import GalleryPosts from '../../../components/gallery/GalleryPosts.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { GALLERY_POSTS_PER_PAGE } from '../../../lib/gallery';

type BlogPost = CollectionEntry<'post'>;

export const getStaticPaths = (async () => {
  const [galleries, posts] = await Promise.all([
    getCollection('gallery'),
    getCollection('post'),
  ]);

  const postsByGallery = new Map<string, BlogPost[]>();

  for (const post of posts) {
    for (const category of post.data.categories) {
      const galleryPosts = postsByGallery.get(category.id) ?? [];
      galleryPosts.push(post);
      postsByGallery.set(category.id, galleryPosts);
    }
  }

  for (const galleryPosts of postsByGallery.values()) {
    galleryPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  }

  return galleries.flatMap((gallery) => {
    const galleryPosts = postsByGallery.get(gallery.id) ?? [];
    const totalPages = Math.max(1, Math.ceil(galleryPosts.length / GALLERY_POSTS_PER_PAGE));

    return Array.from({ length: totalPages }, (_, pageIndex) => {
      const currentPage = pageIndex + 1;
      const pageStart = pageIndex * GALLERY_POSTS_PER_PAGE;

      return {
        params: {
          category: gallery.id,
          page: currentPage === 1 ? undefined : String(currentPage),
        },
        props: {
          gallery,
          pagePosts: galleryPosts.slice(pageStart, pageStart + GALLERY_POSTS_PER_PAGE),
          postCount: galleryPosts.length,
          currentPage,
          totalPages,
        },
      };
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  gallery: CollectionEntry<'gallery'>;
  pagePosts: BlogPost[];
  postCount: number;
  currentPage: number;
  totalPages: number;
}

const { gallery, pagePosts, postCount, currentPage, totalPages } = Astro.props;
const { title, description, thumbnail } = gallery.data;
const pageTitle = currentPage === 1
  ? `${title} ギャラリー | rehu.blog`
  : `${title} ギャラリー - ${currentPage}ページ | rehu.blog`;
---

<BaseLayout title={pageTitle} description={description}>
  <GalleryHeader gallery={gallery} postCount={postCount} />

  <div class="gallery-intro">
    <div class="gallery-intro-info">
      <Image src={thumbnail} alt="" />
      <p>{description}</p>
    </div>
  </div>

  <GalleryPosts
    gallery={gallery}
    posts={pagePosts}
    currentPage={currentPage}
    totalPages={totalPages}
  />
</BaseLayout>

<style>
  .gallery-intro {
    padding: 10px 0;
    border-bottom: 1px solid #d5d5d5;
  }

  .gallery-intro-info {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    min-height: 90px;
  }

  .gallery-intro-info :global(img) {
    display: block;
    flex: 0 0 120px;
    width: 120px;
    height: 90px;
    min-width: 0;
    object-fit: cover;
  }

  .gallery-intro-info p {
    min-width: 0;
    margin: 0;
    color: #475467;
    font-size: 14px;
    line-height: 1.6;
  }

  @media (min-width: 425px) {
    .gallery-intro-info :global(img) {
      flex-basis: 160px;
      width: 160px;
    }
  }

  @media (min-width: 640px) {
    .gallery-intro-info {
      min-height: 100px;
    }

    .gallery-intro-info :global(img) {
      flex-basis: 180px;
      width: 180px;
      height: 100px;
    }
  }
</style>
