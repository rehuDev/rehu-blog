---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import missingPostImage from '../../../assets/imgs/missing-image.avif';
import BaseLayout from "../../../layouts/BaseLayout.astro";

type BlogPost = CollectionEntry<'post'>;
const pageGroupSize = 10;

export const getStaticPaths = (async () => {
  const postsPerPage = 2;
  const [galleries, posts] = await Promise.all([
    getCollection('gallery'),
    getCollection('post'),
  ]);

  const postsByGallery = new Map<string, BlogPost[]>();

  for (const post of posts) {
    for (const category of post.data.categories) {
      const galleryPosts = postsByGallery.get(category.id) ?? [];
      galleryPosts.push(post);
      postsByGallery.set(category.id, galleryPosts);
    }
  }

  for (const galleryPosts of postsByGallery.values()) {
    galleryPosts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
  }

  return galleries.flatMap((gallery) => {
    const galleryPosts = postsByGallery.get(gallery.id) ?? [];
    const totalPages = Math.max(1, Math.ceil(galleryPosts.length / postsPerPage));

    return Array.from({ length: totalPages }, (_, pageIndex) => {
      const currentPage = pageIndex + 1;
      const pageStart = pageIndex * postsPerPage;

      return {
        params: {
          category: gallery.id,
          page: currentPage === 1 ? undefined : String(currentPage),
        },
        props: {
          gallery,
          pagePosts: galleryPosts.slice(pageStart, pageStart + postsPerPage),
          postCount: galleryPosts.length,
          currentPage,
          totalPages,
        },
      };
    });
  });
}) satisfies GetStaticPaths;

interface Props {
  gallery: CollectionEntry<'gallery'>;
  pagePosts: BlogPost[];
  postCount: number;
  currentPage: number;
  totalPages: number;
}

const { gallery, pagePosts, postCount, currentPage, totalPages } = Astro.props;
const { title, description, thumbnail, relatedSites } = gallery.data;
const pageTitle = currentPage === 1
  ? `${title} ギャラリー | rehu.blog`
  : `${title} ギャラリー - ${currentPage}ページ | rehu.blog`;
const pageGroupStart = Math.floor((currentPage - 1) / pageGroupSize) * pageGroupSize + 1;
const pageGroupEnd = Math.min(pageGroupStart + pageGroupSize - 1, totalPages);
const pageNumbers = Array.from(
  { length: pageGroupEnd - pageGroupStart + 1 },
  (_, index) => pageGroupStart + index,
);

const getGalleryPageHref = (page: number) => (
  page === 1 ? `/g/${gallery.id}/` : `/g/${gallery.id}/${page}/`
);

const postDateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Tokyo',
});

const formatPostDate = (date: Date) => postDateFormatter.format(date).replaceAll('/', '.');

const getPostImageSrc = (image?: string) => {
  const src = image?.trim();

  if (!src || /^[a-z][a-z\d+.-]*:/i.test(src) || src.startsWith('//') || src.startsWith('/')) {
    return src;
  }

  return `/${src.replace(/^\.\//, '')}`;
};
---

<BaseLayout title={pageTitle} description={description}>
  <header class="gallery-header">
      <h1>
        <a href={`/g/${gallery.id}/`}>{title}<span> ギャラリー</span></a>
        <small>({postCount}件)</small>
      </h1>
      <div class="gallery-header-action">
        <button type="button" aria-label="ギャラリー情報">
          <span class="action-label-short" aria-hidden="true">ⓘ</span>
          <span class="action-label-long" aria-hidden="true">ギャラリー情報</span>
        </button>
        {relatedSites.length > 0 && (
          <button
            type="button"
            aria-label="関連サイト"
            aria-haspopup="dialog"
            aria-controls="related-sites-dialog"
            aria-expanded="false"
            data-related-sites-open
          >
            <span class="action-label-short" aria-hidden="true">関連</span>
            <span class="action-label-long" aria-hidden="true">関連サイト</span>
          </button>
        )}
        <button>案内</button>
      </div>
  </header>
  <div class="gallery-intro">
    <div class="gallery-intro-info">
      <Image src={thumbnail} alt="" />
      <p>{description}</p>
    </div>
  </div>

  <section class="gallery-posts" aria-label="投稿一覧">
    <div class="gallery-post-toolbar">
      <div class="gallery-post-toolbar-group" role="group" aria-label="投稿の種類">
        <button class="gallery-post-toolbar-button" type="button" aria-pressed="true">全体</button>
        <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">人気</button>
        <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">お知らせ</button>
      </div>
      <div class="gallery-post-toolbar-group" role="group" aria-label="表示形式">
        <button class="gallery-post-toolbar-button" type="button" aria-pressed="false">簡潔</button>
        <button class="gallery-post-toolbar-button" type="button" aria-pressed="true">画像</button>
      </div>
    </div>
    <div class="gallery-post-table-head" aria-hidden="true">
      <span>投稿</span>
      <span>公開日</span>
    </div>
    <div class="gallery-post-list">
      {pagePosts.map((post) => {
        const postHref = `/posts/${post.id}/`;
        const postImage = getPostImageSrc(post.data.image);

        return (
        <article class="gallery-post-item">
          <a class="gallery-post-link" href={postHref}>
            <span class="gallery-post-thumbnail" aria-hidden="true">
              {postImage
                ? <img src={postImage} alt="" loading="lazy" decoding="async" />
                : <img
                    src={missingPostImage.src}
                    alt=""
                    loading="lazy"
                    decoding="async"
                  />}
            </span>
            <div class="gallery-post-content">
              <div class="gallery-post-body">
                <h2>{post.data.title}</h2>
                <p>{post.data.description}</p>
              </div>
              <div class="gallery-post-details">
                <div class="gallery-post-tags">
                  {post.data.mcategories?.map((category) => <span data-post-tag>{category}</span>)}
                  <span
                    class="gallery-post-tags-more"
                    aria-label="その他のタグ"
                    data-post-tags-more
                    hidden
                  >…</span>
                </div>
                <time datetime={post.data.pubDate.toISOString()}>{formatPostDate(post.data.pubDate)}</time>
              </div>
            </div>
          </a>
        </article>
        );
      })}
      {pagePosts.length === 0 && <p class="gallery-post-empty">まだ投稿はありません。</p>}
    </div>

    {totalPages > 1 && (
      <nav class="gallery-pagination" aria-label="投稿ページ">
        {currentPage > 1
          ? <a class="pagination-link pagination-direction" href={getGalleryPageHref(currentPage - 1)}>前へ</a>
          : <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">前へ</span>}

        <div class="pagination-numbers">
          {pageNumbers.map((page) => (
            page === currentPage
              ? <span class="pagination-link is-current" aria-current="page">{page}</span>
              : <a class="pagination-link" href={getGalleryPageHref(page)}>{page}</a>
          ))}
        </div>

        {currentPage < totalPages
          ? <a class="pagination-link pagination-direction" href={getGalleryPageHref(currentPage + 1)}>次へ</a>
          : <span class="pagination-link pagination-direction is-disabled" aria-disabled="true">次へ</span>}
      </nav>
    )}
  </section>

  {relatedSites.length > 0 && (
    <dialog
      id="related-sites-dialog"
      class="related-sites-dialog"
      aria-labelledby="related-sites-title"
      aria-describedby="related-sites-description"
      data-related-sites-dialog
    >
      <div class="related-sites-panel">
        <header class="related-sites-header">
          <div>
            <span>{title} ギャラリー</span>
            <h2 id="related-sites-title">関連サイト</h2>
            <p id="related-sites-description">このギャラリーに関連するサイトです。</p>
          </div>
          <form method="dialog">
            <button class="related-sites-close" value="close" aria-label="閉じる">×</button>
          </form>
        </header>

        <ul class="related-sites-list">
          {relatedSites.map((site) => (
            <li>
              <a href={site.url} target="_blank" rel="noopener noreferrer">
                <span class="related-site-title">
                  {site.title}
                  <span aria-hidden="true">↗</span>
                </span>
                {site.description && <span class="related-site-description">{site.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </dialog>
  )}
</BaseLayout>

<script>
  const relatedSitesDialog = document.querySelector<HTMLDialogElement>('[data-related-sites-dialog]');
  const relatedSitesOpenButton = document.querySelector<HTMLButtonElement>('[data-related-sites-open]');

  relatedSitesOpenButton?.addEventListener('click', () => {
    relatedSitesDialog?.showModal();
    relatedSitesOpenButton.setAttribute('aria-expanded', 'true');
  });

  relatedSitesDialog?.addEventListener('close', () => {
    relatedSitesOpenButton?.setAttribute('aria-expanded', 'false');
  });

  relatedSitesDialog?.addEventListener('click', (event) => {
    if (event.target === relatedSitesDialog) {
      relatedSitesDialog.close();
    }
  });

  const postTagLists = document.querySelectorAll<HTMLElement>('.gallery-post-tags');

  const fitPostTags = () => {
    for (const tagList of postTagLists) {
      const tags = [...tagList.querySelectorAll<HTMLElement>('[data-post-tag]')];
      const moreTag = tagList.querySelector<HTMLElement>('[data-post-tags-more]');

      tags.forEach((tag) => tag.hidden = false);
      if (moreTag) moreTag.hidden = true;

      const listRight = tagList.getBoundingClientRect().right;
      let hasOverflow = false;

      for (const tag of tags) {
        if (hasOverflow || tag.getBoundingClientRect().right > listRight + 0.5) {
          tag.hidden = true;
          hasOverflow = true;
        }
      }

      if (!hasOverflow || !moreTag) continue;

      moreTag.hidden = false;

      while (moreTag.getBoundingClientRect().right > listRight + 0.5) {
        const lastVisibleTag = tags.findLast((tag) => !tag.hidden);
        if (!lastVisibleTag) break;
        lastVisibleTag.hidden = true;
      }
    }
  };

  if (postTagLists.length > 0) {
    const postTagResizeObserver = new ResizeObserver(fitPostTags);
    postTagLists.forEach((tagList) => postTagResizeObserver.observe(tagList));
    requestAnimationFrame(fitPostTags);
  }
</script>

<style>
  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
