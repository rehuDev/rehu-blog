---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from "../../layouts/BaseLayout.astro";

export const getStaticPaths = (async () => {
  const [galleries, posts] = await Promise.all([
    getCollection('gallery'),
    getCollection('post'),
  ]);

  const postCountByGallery = new Map<string, number>();

  for (const post of posts) {
    for (const category of post.data.categories) {
      postCountByGallery.set(
        category.id,
        (postCountByGallery.get(category.id) ?? 0) + 1,
      );
    }
  }

  return galleries.map((gallery) => ({
    params: { category: gallery.id },
    props: {
      gallery,
      postCount: postCountByGallery.get(gallery.id) ?? 0,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  gallery: CollectionEntry<'gallery'>;
  postCount: number;
}

const { gallery, postCount } = Astro.props;
const { title, description, thumbnail, relatedSites } = gallery.data;

const dummyPosts = [
  {
    title: '投稿タイトルのサンプルです',
    description: '投稿の内容がどのようなものか分かるように、短い説明文をここに表示します。',
    date: '2026.08.31',
  },
  {
    title: '少し長い投稿タイトルが入った場合の表示サンプル',
    description: '二行程度の概要文を想定したダミーテキストです。長い文章は途中で省略されます。',
    date: '2026.08.30',
  },
  {
    title: 'ギャラリーに関する三つ目の記事',
    description: 'サムネイル、公開日、タイトル、概要を並べた投稿一覧のレイアウト確認用です。',
    date: '2026.08.29',
  },
];
---

<BaseLayout title={`${title} ギャラリー | rehu.blog`} description={description}>
  <header class="gallery-header">
      <h1>
        <a href={`/g/${gallery.id}/`}>{title}<span> ギャラリー</span></a>
        <small>({postCount}件)</small>
      </h1>
      <div class="gallery-header-action">
        <button type="button" aria-label="ギャラリー情報">
          <span class="action-label-short" aria-hidden="true">ⓘ</span>
          <span class="action-label-long" aria-hidden="true">ギャラリー情報</span>
        </button>
        {relatedSites.length > 0 && (
          <button
            type="button"
            aria-label="関連サイト"
            aria-haspopup="dialog"
            aria-controls="related-sites-dialog"
            aria-expanded="false"
            data-related-sites-open
          >
            <span class="action-label-short" aria-hidden="true">関連</span>
            <span class="action-label-long" aria-hidden="true">関連サイト</span>
          </button>
        )}
      </div>
  </header>
  <div class="gallery-intro">
    <div class="gallery-intro-info">
      <Image src={thumbnail} alt="" />
      <p>{description}</p>
    </div>
  </div>

  <section class="gallery-posts" aria-labelledby="gallery-posts-title">
    <header class="gallery-posts-header">
      <h2 id="gallery-posts-title">投稿一覧</h2>
      <span>{dummyPosts.length}件</span>
    </header>
    <div class="gallery-post-list">
      {dummyPosts.map((post, index) => (
        <article class="gallery-post-item">
          <a class="gallery-post-thumbnail" href={`/g/${gallery.id}/`} aria-hidden="true" tabindex="-1">
            <span>{String(index + 1).padStart(2, '0')}</span>
          </a>
          <div class="gallery-post-body">
            <h3><a href={`/g/${gallery.id}/`}>{post.title}</a></h3>
            <div class="gallery-post-meta">
              <time>{post.date}</time>
              <span>サンプル</span>
            </div>
            <p>{post.description}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  {relatedSites.length > 0 && (
    <dialog
      id="related-sites-dialog"
      class="related-sites-dialog"
      aria-labelledby="related-sites-title"
      aria-describedby="related-sites-description"
      data-related-sites-dialog
    >
      <div class="related-sites-panel">
        <header class="related-sites-header">
          <div>
            <span>{title} ギャラリー</span>
            <h2 id="related-sites-title">関連サイト</h2>
            <p id="related-sites-description">このギャラリーに関連するサイトです。</p>
          </div>
          <form method="dialog">
            <button class="related-sites-close" value="close" aria-label="閉じる">×</button>
          </form>
        </header>

        <ul class="related-sites-list">
          {relatedSites.map((site) => (
            <li>
              <a href={site.url} target="_blank" rel="noopener noreferrer">
                <span class="related-site-title">
                  {site.title}
                  <span aria-hidden="true">↗</span>
                </span>
                {site.description && <span class="related-site-description">{site.description}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </dialog>
  )}
</BaseLayout>

<script>
  const relatedSitesDialog = document.querySelector<HTMLDialogElement>('[data-related-sites-dialog]');
  const relatedSitesOpenButton = document.querySelector<HTMLButtonElement>('[data-related-sites-open]');

  relatedSitesOpenButton?.addEventListener('click', () => {
    relatedSitesDialog?.showModal();
    relatedSitesOpenButton.setAttribute('aria-expanded', 'true');
  });

  relatedSitesDialog?.addEventListener('close', () => {
    relatedSitesOpenButton?.setAttribute('aria-expanded', 'false');
  });

  relatedSitesDialog?.addEventListener('click', (event) => {
    if (event.target === relatedSitesDialog) {
      relatedSitesDialog.close();
    }
  });
</script>

<style>
  .gallery-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 8px;
    min-width: 0;
    border-bottom: 2px solid var(--dc-blue-2);
  }

  /* gallery title */
  .gallery-header h1 {
    display: flex;
    flex: 1 1 auto;
    align-items: baseline;
    gap: 6px;
    min-width: 0;
    margin: 0;
    font-size: 24px;
    line-height: 1.35;
  }
  .gallery-header h1 a {
    display: block;
    flex: 0 1 auto;
    min-width: 0;
    overflow: hidden;
    color: var(--dc-blue-2);
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .gallery-header h1 small {
    flex: 0 0 auto;
    color: #98a2b3;
    font-size: 12px;
    font-weight: 400;
  }
  .gallery-header h1 a:hover,
  .gallery-header h1 a:focus-visible {
    color: var(--dc-blue-3);
    outline: none;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .gallery-header h1 span {
    display: none;
  }

  /* gallery header actions */
  .gallery-header-action {
    display: flex;
    position: relative;
    flex: 0 0 auto;
    align-self: flex-end;
    align-items: flex-end;
    height: 100%;
  }
  .gallery-header-action button {
    display: inline-flex;
    position: relative;
    align-items: center;
    padding: 1px 1px;
    border: 0;
    background-color: transparent;
    color: #475467;
    font-size: 12px;
    white-space: nowrap;
    cursor: pointer;
  }
  .gallery-header-action button:hover,
  .gallery-header-action button:focus-visible {
    border-color: var(--dc-blue-2);
    background: #f1f4ff;
    color: var(--dc-blue-2);
    outline: none;
  }
  .gallery-header-action button + button {
    margin-left: 9px;
  }
  .gallery-header-action button + button::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -5px;
    width: 1px;
    height: 10px;
    background-color: #ccc;
    transform: translateY(-50%);
    pointer-events: none;
  }

  .gallery-header-action .action-label-long {
    display: none;
  }

  /* related sites popup */

  /* gallery intro box */
  .gallery-intro {
    padding: 10px 0;
    border-bottom: 1px solid #d5d5d5;
  }

  .gallery-intro-info {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    min-width: 0;
    min-height: 90px;
  }

  .gallery-intro-info :global(img) {
    display: block;
    flex: 0 0 120px;
    width: 120px;
    height: 90px;
    min-width: 0;
    object-fit: cover;
  }

  .gallery-intro-info p {
    min-width: 0;
    margin: 0;
    color: #475467;
    font-size: 14px;
    line-height: 1.6;
  }

  /* temporary post list preview */
  .gallery-posts {
    margin-top: 18px;
  }

  .gallery-posts-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 6px;
    border-bottom: 2px solid var(--dc-blue-2);
  }

  .gallery-posts-header h2 {
    margin: 0;
    color: var(--dc-blue-2);
    font-size: 18px;
  }

  .gallery-posts-header span {
    color: #667085;
    font-size: 12px;
  }

  .gallery-post-list {
    display: grid;
  }

  .gallery-post-item {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px solid #e1e4ea;
  }

  .gallery-post-thumbnail {
    display: grid;
    place-items: center;
    width: 96px;
    height: 72px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(41, 54, 124, 0.82), rgba(59, 72, 144, 0.45)),
      #e9edff;
    color: rgba(255, 255, 255, 0.9);
    font-size: 20px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .gallery-post-body {
    min-width: 0;
  }

  .gallery-post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: #667085;
    font-size: 11px;
  }

  .gallery-post-meta span {
    padding: 1px 5px;
    background: #f1f4ff;
    color: var(--dc-blue-2);
  }

  .gallery-post-body h3 {
    margin: 0;
    overflow: hidden;
    font-size: 15px;
    line-height: 1.4;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gallery-post-body h3 a {
    color: #1f2937;
    text-decoration: none;
  }

  .gallery-post-body h3 a:hover,
  .gallery-post-body h3 a:focus-visible {
    color: var(--dc-blue-2);
    outline: none;
    text-decoration: underline;
  }

  .gallery-post-body p {
    display: -webkit-box;
    margin: 4px 0 0;
    overflow: hidden;
    color: #667085;
    font-size: 12px;
    line-height: 1.45;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  .related-sites-dialog {
    width: min(calc(100% - 32px), 560px);
    max-width: none;
    max-height: calc(100dvh - 48px);
    padding: 0;
    overflow: hidden;
    border: 1px solid #cfd6e4;
    border-radius: 12px;
    background: #fff;
    color: #1f2937;
    box-shadow: 0 20px 60px rgba(15, 23, 42, 0.26);
  }

  .related-sites-dialog::backdrop {
    background: rgba(15, 23, 42, 0.48);
    backdrop-filter: blur(2px);
  }

  .related-sites-panel {
    display: grid;
    max-height: calc(100dvh - 48px);
    grid-template-rows: auto minmax(0, 1fr);
  }

  .related-sites-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 18px 14px;
    border-bottom: 1px solid #e1e6ef;
    background: #f7f9ff;
  }

  .related-sites-header > div > span {
    display: block;
    margin-bottom: 2px;
    color: #667085;
    font-size: 11px;
  }

  .related-sites-header h2 {
    margin: 0;
    color: var(--dc-blue-2);
    font-size: 20px;
    line-height: 1.35;
  }

  .related-sites-header p {
    margin: 4px 0 0;
    color: #667085;
    font-size: 12px;
    line-height: 1.5;
  }

  .related-sites-header form {
    flex: 0 0 auto;
  }

  .related-sites-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: #667085;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .related-sites-close:hover,
  .related-sites-close:focus-visible {
    border-color: #d5dbea;
    background: #fff;
    color: var(--dc-blue-2);
    outline: none;
  }

  .related-sites-list {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 14px;
    overflow-y: auto;
    list-style: none;
  }

  .related-sites-list a {
    display: block;
    padding: 12px 14px;
    border: 1px solid #e0e5ee;
    border-radius: 8px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: border-color 120ms ease, background-color 120ms ease;
  }

  .related-sites-list a:hover,
  .related-sites-list a:focus-visible {
    border-color: #aeb9db;
    background: #f7f9ff;
    outline: none;
  }

  .related-site-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: var(--dc-blue-2);
    font-size: 14px;
    font-weight: 700;
  }

  .related-site-title > span {
    flex: 0 0 auto;
    color: #98a2b3;
    font-size: 12px;
  }

  .related-site-description {
    display: block;
    margin-top: 4px;
    color: #667085;
    font-size: 12px;
    line-height: 1.5;
  }

  @media (min-width: 425px) {
    .gallery-header h1 span {
      display: inline;
    }

    .gallery-intro-info :global(img) {
      flex: 0 0 160px;
      width: 160px;
      height: 90px;
    }
  }

  @media (min-width: 640px) {
    .gallery-header h1,
    .gallery-header-action {
      margin-bottom: 3px;
    }
    .gallery-header-action .action-label-long {
      display: inline;
    }

    .gallery-header-action .action-label-short {
      display: none;
    }

    .gallery-intro-info {
      min-height: 100px;
    }

    .gallery-intro-info :global(img) {
      flex: 0 0 180px;
      width: 180px;
      height: 100px;
    }

    .gallery-post-item {
      grid-template-columns: 160px minmax(0, 1fr);
      gap: 16px;
      padding: 14px 0;
    }

    .gallery-post-thumbnail {
      width: 160px;
      height: 100px;
    }

    .gallery-post-body h3 {
      font-size: 17px;
    }

    .gallery-post-body p {
      font-size: 13px;
    }
  }

  @media (min-width: 768px) {
  }
</style>
