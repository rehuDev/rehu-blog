---
import type { CollectionEntry } from 'astro:content';
import { getEntries } from 'astro:content';
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: CollectionEntry<'post'>;
  olderPost?: CollectionEntry<'post'>;
  newerPost?: CollectionEntry<'post'>;
}

const { post, olderPost, newerPost } = Astro.props;
const {
  title,
  description,
  image,
  categories,
  mcategories,
  pubDate,
  updDate,
} = post.data;

const galleries = await getEntries(categories);

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Tokyo',
});
---

<BaseLayout title={`${title} | rehu.blog`} description={description}>
  <div class="post-shell">
    <header class="post-header">
      <nav class="post-categories" aria-label="記事のカテゴリー">
        <ul>
          {galleries.map((gallery) => (
            <li><a href={`/g/${gallery.id}/`}>{gallery.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <h1>{title}</h1>
      <p class="post-description">{description}</p>

      <div class="post-dates" aria-label="記事の日付">
        <span>
          公開 <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        </span>
        {updDate && (
          <span>
            更新 <time datetime={updDate.toISOString()}>{dateFormatter.format(updDate)}</time>
          </span>
        )}
      </div>
    </header>

    {image && (
      <figure class="post-cover">
        <img src={image} alt="" loading="eager" fetchpriority="high" />
      </figure>
    )}

    <div class="post-content">
      <slot />
    </div>

    <footer class="post-footer">
      {mcategories && mcategories.length > 0 && (
        <section class="post-tags" aria-labelledby="post-tags-title">
          <h2 id="post-tags-title">関連タグ</h2>
          <ul>
            {mcategories.map((category) => (
              <li>#{category}</li>
            ))}
          </ul>
        </section>
      )}

      {(olderPost || newerPost) && (
        <nav class="post-pagination" aria-label="前後の記事">
          {olderPost && (
            <a class="post-older" href={`/posts/${olderPost.id}/`}>
              <span class="post-pagination-label">← 古い記事</span>
              <strong>{olderPost.data.title}</strong>
            </a>
          )}
          {newerPost && (
            <a class="post-newer" href={`/posts/${newerPost.id}/`}>
              <span class="post-pagination-label">新しい記事 →</span>
              <strong>{newerPost.data.title}</strong>
            </a>
          )}
        </nav>
      )}

      <a class="post-list-link" href="/">記事一覧へ戻る</a>
    </footer>
  </div>
</BaseLayout>

<style>
  .post-shell {
    padding: 0.5rem 0 3.5rem;
  }

  .post-header {
    width: 100%;
    margin: 0;
    padding: 1.35rem 0 1.6rem;
    border-top: 4px solid var(--dc-blue-3);
    border-bottom: 1px solid #dfe2ee;
  }

  .post-categories ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.15rem;
    padding: 0;
    list-style: none;
  }

  .post-categories a {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.15rem 0.6rem;
    border: 1px solid #aeb8dc;
    border-radius: 2px;
    background: #f5f6fb;
    color: #354785;
    font-size: 0.75rem;
    font-weight: var(--font-semibold);
    line-height: 1.25;
    text-decoration: none;
  }

  .post-categories a:hover {
    border-color: var(--dc-blue-3);
    background: var(--dc-blue-3);
    color: #fff;
  }

  .post-categories a:focus-visible {
    outline: 2px solid var(--dc-blue-3);
    outline-offset: 3px;
  }

  h1 {
    margin: 0;
    color: #171b30;
    font-size: clamp(2rem, 7vw, 3.25rem);
    font-weight: var(--font-bold);
    letter-spacing: -0.035em;
    line-height: 1.2;
    line-break: strict;
    text-wrap: wrap;
  }

  .post-description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #5b6074;
    font-size: clamp(1rem, 3.2vw, 1.15rem);
    line-height: 1.65;
  }

  .post-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 1.35rem;
    color: #777b8c;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .post-dates span {
    display: inline-flex;
    gap: 0.35rem;
  }

  .post-dates span + span::before {
    content: "·";
    margin-right: 0.15rem;
    color: #b1b4c0;
  }

  .post-dates time {
    color: #4e5366;
    font-weight: var(--font-medium);
  }

  .post-cover {
    width: 100%;
    margin: 2rem 0 0;
  }

  .post-cover img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 520px;
    border-radius: 3px;
    object-fit: cover;
  }

  .post-content {
    margin-top: 2.25rem;
  }

  .post-footer {
    width: 100%;
    margin: 3.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid #dfe2ee;
  }

  .post-tags {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.65rem 0.85rem;
  }

  .post-tags h2 {
    margin: 0;
    color: #666b7d;
    font-size: 0.75rem;
    font-weight: var(--font-semibold);
    line-height: 1.75rem;
  }

  .post-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: #eef0f7;
    color: #555e80;
    font-size: 0.75rem;
    line-height: 1.35rem;
  }

  .post-pagination {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.65rem;
    margin-top: 1.75rem;
  }

  .post-pagination a {
    display: flex;
    min-height: 6.25rem;
    flex-direction: column;
    justify-content: center;
    gap: 0.4rem;
    padding: 1rem 1.1rem;
    border: 1px solid #d6d9e5;
    border-radius: 3px;
    background: #fafafd;
    color: #252b4b;
    text-decoration: none;
  }

  .post-pagination a:hover {
    border-color: #8e9ac8;
    background: #f3f4f9;
  }

  .post-pagination a:focus-visible,
  .post-list-link:focus-visible {
    outline: 2px solid var(--dc-blue-3);
    outline-offset: 3px;
  }

  .post-pagination-label {
    color: #777d93;
    font-size: 0.72rem;
    font-weight: var(--font-semibold);
  }

  .post-pagination strong {
    font-size: 0.95rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .post-newer {
    text-align: right;
  }

  .post-list-link {
    display: table;
    margin: 1.5rem auto 0;
    padding: 0.45rem 0.2rem;
    color: #4f587e;
    font-size: 0.78rem;
    font-weight: var(--font-semibold);
    text-underline-offset: 0.2em;
  }

  @media (min-width: 768px) {
    .post-shell {
      padding-top: 1.2rem;
      padding-bottom: 4.5rem;
    }

    .post-header {
      padding-top: 1.75rem;
      padding-bottom: 2rem;
    }

    .post-categories ul {
      margin-bottom: 1.4rem;
    }

    .post-cover {
      margin-top: 2.5rem;
    }

    .post-content {
      margin-top: 3rem;
    }

    .post-footer {
      margin-top: 4.5rem;
      padding-top: 1.75rem;
    }

    .post-pagination {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem;
      margin-top: 2rem;
    }

    .post-newer {
      grid-column: 2;
    }
  }
</style>
