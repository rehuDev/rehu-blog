---
import type { CollectionEntry } from 'astro:content';
import GalleryHeader from '../components/gallery/GalleryHeader.astro';
import GalleryPosts from '../components/gallery/GalleryPosts.astro';
import type { GalleryPostContext } from '../lib/gallery';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'post'>;
  galleryContexts: GalleryPostContext[];
}

const { post, galleryContexts } = Astro.props;
const {
  title,
  description,
  mcategories,
  pubDate,
  updDate,
} = post.data;
const defaultGalleryId = galleryContexts[0]?.gallery.id;

const dateFormatter = new Intl.DateTimeFormat('ja-JP', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  timeZone: 'Asia/Tokyo',
});
---

<BaseLayout title={`${title} | rehu.blog`} description={description}>
  <script slot="head" is:inline>
    if (new URLSearchParams(window.location.search).has('g')) {
      document.documentElement.classList.add('post-gallery-pending');
    }
  </script>

  <div
    class="post-shell"
    data-post-gallery-root
    data-default-gallery={defaultGalleryId}
  >
    <div class="post-gallery-headers">
      {galleryContexts.map((context, index) => (
        <div data-post-gallery-context={context.gallery.id} hidden={index !== 0}>
          <GalleryHeader gallery={context.gallery} postCount={context.postCount} />
        </div>
      ))}
    </div>

    <header class="post-header">
      <h1>{title}</h1>
      <p class="post-description">{description}</p>

      <div class="post-dates" aria-label="記事の日付">
        <span>
          公開 <time datetime={pubDate.toISOString()}>{dateFormatter.format(pubDate)}</time>
        </span>
        {updDate && (
          <span>
            更新 <time datetime={updDate.toISOString()}>{dateFormatter.format(updDate)}</time>
          </span>
        )}
      </div>
    </header>

    <div class="post-content">
      <slot />
    </div>

    <footer class="post-footer">
      {mcategories && mcategories.length > 0 && (
        <section class="post-tags" aria-labelledby="post-tags-title">
          <h2 id="post-tags-title">関連タグ</h2>
          <ul>
            {mcategories.map((category) => (
              <li>#{category}</li>
            ))}
          </ul>
        </section>
      )}

      <div class="post-gallery-posts">
        {galleryContexts.map((context, index) => (
          <div data-post-gallery-context={context.gallery.id} hidden={index !== 0}>
            <GalleryPosts
              gallery={context.gallery}
              posts={context.pagePosts}
              currentPage={context.currentPage}
              totalPages={context.totalPages}
              currentPostId={post.id}
            />
          </div>
        ))}
      </div>
    </footer>
  </div>

  <script is:inline>
    try {
      document.querySelectorAll('[data-post-gallery-root]').forEach((root) => {
        const contexts = [...root.querySelectorAll('[data-post-gallery-context]')];
        const galleryIds = new Set(
          contexts.map((context) => context.dataset.postGalleryContext),
        );
        const requestedGallery = new URLSearchParams(window.location.search).get('g');
        const defaultGallery = root.dataset.defaultGallery;
        const activeGallery = requestedGallery && galleryIds.has(requestedGallery)
          ? requestedGallery
          : defaultGallery;

        contexts.forEach((context) => {
          context.hidden = context.dataset.postGalleryContext !== activeGallery;
        });
      });
    } finally {
      document.documentElement.classList.remove('post-gallery-pending');
    }
  </script>
</BaseLayout>

<style is:global>
  html.post-gallery-pending [data-post-gallery-context] {
    visibility: hidden;
  }
</style>

<style>
  .post-shell {
    padding: 0;
  }

  .post-header {
    width: 100%;
    margin: 0;
    padding: 1.35rem 0 1.6rem;
    border-bottom: 1px solid #dfe2ee;
  }

  h1 {
    margin: 0;
    color: #171b30;
    font-size: clamp(2rem, 7vw, 3.25rem);
    font-weight: var(--font-bold);
    letter-spacing: -0.035em;
    line-height: 1.2;
    line-break: strict;
    text-wrap: wrap;
  }

  .post-description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #5b6074;
    font-size: clamp(1rem, 3.2vw, 1.15rem);
    line-height: 1.65;
  }

  .post-dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    margin-top: 0.5rem;
    color: #777b8c;
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
  }

  .post-dates span {
    display: inline-flex;
    gap: 0.35rem;
  }

  .post-dates span + span::before {
    content: "·";
    margin-right: 0.15rem;
    color: #b1b4c0;
  }

  .post-dates time {
    color: #4e5366;
    font-weight: var(--font-medium);
  }

  .post-content {
    margin-top: 1.6rem;
  }

  .post-footer {
    width: 100%;
    margin: 3.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid #dfe2ee;
  }

  .post-tags {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 0.65rem 0.85rem;
  }

  .post-tags h2 {
    margin: 0;
    color: #666b7d;
    font-size: 0.75rem;
    font-weight: var(--font-semibold);
    line-height: 1.75rem;
  }

  .post-tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-tags li {
    padding: 0.2rem 0.55rem;
    border-radius: 2px;
    background: #eef0f7;
    color: #555e80;
    font-size: 0.75rem;
    line-height: 1.35rem;
  }

  .post-gallery-posts {
    margin-top: 2rem;
  }

  @media (min-width: 768px) {
    .post-header {
      padding-top: 1.75rem;
      padding-bottom: 2rem;
    }

    .post-content {
      margin-top: 2rem;
    }

    .post-footer {
      margin-top: 4.5rem;
      padding-top: 1.75rem;
    }
  }
</style>
